{
  "browser": {
    "launchOptions": {
      "headless": true,
      "args": [
        "--use-fake-ui-for-media-stream",
        "--use-fake-device-for-media-stream"
      ]
    },
    "contextOptions": {
      "viewport": { "width": 1280, "height": 720 }
    }
  },
  "timeouts": {
    "action": 15000,
    "navigation": 90000
  },
  "outputDir": ".playwright-cli",
  "outputMode": "file"
}
