# Optional default session for commands that omit -s=
# PLAYWRIGHT_CLI_SESSION=visitor

# Playwright CLI config (local headed vs CI headless)
# PLAYWRIGHT_CLI_CONFIG=.playwright/cli.config.json
# PLAYWRIGHT_CLI_CONFIG=.playwright/cli.config.ci.json

# Cobrowse test page overrides
# COBROWSE_GROUP_ID=21552
# COBROWSE_WEB_SERVER=www.myglance.net
# COBROWSE_CDN=cdn.myglance.net
# COBROWSE_VISITOR_URL=https://dev-cobrowse-test.myglance.net/cobrowse/test
# COBROWSE_SETTINGS_URL=https://dev-cobrowse-test.myglance.net/cobrowse/test/TestPageSettings
# COBROWSE_AGENT_JOIN_URL=https://www.myglance.net/agentjoin/AgentJoin.aspx

# CI / automated agent login (set in GitHub Secrets for Actions — do not commit real values)
# GLANCE_AGENT_USER=yourname21552.glance.net
# GLANCE_AGENT_PASSWORD=

# Auto-grant camera/microphone for co-browse video (new browser launches)
# PLAYWRIGHT_MCP_GRANT_PERMISSIONS=camera,microphone

# Set to 1 when running in GitHub Actions or local CI dry-run
# CI=1
