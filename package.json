{
  "name": "poc-playwright-cli",
  "version": "1.0.0",
  "description": "POC: @playwright/cli with dual Cursor sessions for MyGlance co-browse",
  "private": true,
  "scripts": {
    "cli:help": "playwright-cli --help",
    "cli:install": "playwright-cli install",
    "cli:skills": "playwright-cli install --skills agents",
    "cli:install-browser": "playwright-cli install-browser",
    "sessions:open": "bash scripts/open-sessions.sh",
    "sessions:show": "playwright-cli show",
    "sessions:close": "bash scripts/close-sessions.sh",
    "sessions:list": "playwright-cli list",
    "test:configure-visitor": "bash scripts/test-configure-visitor.sh",
    "test:start-visitor-cobrowse": "bash scripts/test-start-visitor-cobrowse.sh",
    "test:agent-join": "bash scripts/test-agent-join.sh",
    "test:grant-media": "bash scripts/test-grant-media.sh",
    "test:prepare-post-join": "bash scripts/test-prepare-post-join.sh",
    "test:assert": "node tests/run-assertions.mjs",
    "test:assert:pre-join": "node tests/run-assertions.mjs --group preJoin",
    "test:start-cobrowse-session": "bash scripts/test-start-cobrowse-session.sh",
    "test:start-cobrowse-session-with-video": "bash scripts/test-start-cobrowse-session-with-video.sh",
    "test:assert:video": "node tests/run-assertions.mjs --case start-cobrowse-session-with-video --group video",
    "test:assert:video:all": "node tests/run-assertions.mjs --case start-cobrowse-session-with-video --group all",
    "test:agent-viewer-header": "bash scripts/test-agent-viewer-header.sh",
    "test:header:video": "bash scripts/test-header-agent-video.sh",
    "test:header:visitor-info": "bash scripts/test-header-visitor-info.sh",
    "test:header:share-screen": "bash scripts/test-header-share-screen.sh",
    "test:header:share-document": "bash scripts/test-header-share-document.sh",
    "test:header:add-guest": "bash scripts/test-header-add-guest.sh",
    "test:end-session": "bash scripts/test-end-session.sh",
    "test:ci:e2e:video": "bash scripts/ci-e2e-video.sh",
    "ci:extract-session-code": "node tests/lib/extract-session-code.mjs"
  },
  "keywords": ["playwright", "playwright-cli", "cursor", "cobrowse"],
  "license": "ISC",
  "devDependencies": {
    "@playwright/cli": "^0.1.13"
  }
}
